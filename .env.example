# Deployment Target (REQUIRED for "bun run deploy")
DEPLOY_HOST=raspberrypi.local
DEPLOY_USER=pi
DEPLOY_KEY=  # Optional: path to SSH key file

# Proxy bridge connection (defaults to DEPLOY_HOST if not set)
# BRIDGE_HOST=10.255.5.52

# RTSP camera pointed at device LCD (used by "bun run proxy")
# RTSP_URL=rtsp://192.168.1.100:554/stream
# ffmpeg video filter for RTSP (crop, rotate, etc. — any valid -vf string)
# Examples: "crop=700:750:0:0" or "crop=700:750:0:0,rotate=PI/2" or "transpose=1"
# RTSP_FILTER=crop=700:750:0:0