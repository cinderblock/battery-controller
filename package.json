{
  "name": "battery-charge-discharge-controller",
  "version": "0.1.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "bun --watch src/run/deploy.ts",
    "build": "bun run src/run/build.ts",
    "status": "bun run src/run/status.ts",
    "proxy": "bun run src/proxy/index.ts",
    "analyze": "bun run src/analyzer/index.ts",
    "lint": "biome check --write .",
    "format": "biome format --write . && prettier --write \"**/*.md\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-use-websocket": "^4.13.0",
    "node-null": "link:node-null",
    "ssh2": "^1.16.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.5",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0"
  }
}
